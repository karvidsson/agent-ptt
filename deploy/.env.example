# Copy to deploy/.env on the server; chmod 600 deploy/.env.
# Use managed PostgreSQL with TLS; URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/agent_ptt?sslmode=require&connect_timeout=5
AGENT_PTT_PUBLIC_ORIGIN=https://chat.example.com
# Closed by default. Set 1 temporarily to create the initial owner, then close it.
AGENT_PTT_SIGNUP=0
