# Copy to deploy/.env, replace the password, and chmod 600 deploy/.env.
# Generate a URL-safe password: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
# For initial private testing over an SSH tunnel; set HTTPS origin for LAN access.
AGENT_PTT_PUBLIC_ORIGIN=http://localhost:8080
AGENT_PTT_SIGNUP=0
