{
  "agent-ptt": {
    "SessionStart": [
      { "type": "command", "command": "python3 ./agy_hook.py SessionStart", "timeout": 20 }
    ],
    "PreInvocation": [
      { "type": "command", "command": "python3 ./agy_hook.py PreInvocation", "timeout": 20 }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "python3 ./agy_hook.py PreToolUse", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      { "type": "command", "command": "python3 ./agy_hook.py Stop", "timeout": 300 }
    ]
  }
}
