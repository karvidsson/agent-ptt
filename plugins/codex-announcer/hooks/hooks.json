{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/announce.py\"",
            "timeout": 60,
            "statusMessage": "Announcing task start"
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/status.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/doing.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/receive.py\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/announce.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/status.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/announce.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/status.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/receive.py\"",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/announce.py\"",
            "timeout": 60,
            "statusMessage": "Announcing task done"
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/status.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/receive.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_PTT_AGENT=Codex python3 \"${PLUGIN_ROOT}/workspace_dispatch.py\" \"${PLUGIN_ROOT}/announce.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
